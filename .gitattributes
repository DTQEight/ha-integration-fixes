# 统一 LF，避免 Windows 上 CRLF 污染 YAML/JSON 与前端脚本
* text=auto eol=lf

*.py   text eol=lf
*.js   text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.sh   text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.db   binary
